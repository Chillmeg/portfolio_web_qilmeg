---
/* Cargo's pinned "TopMenu": name on the left, three links on a 12-column grid
   with spans 3 / 1 / 2 / 2 / 2 / 2. The current section shows in red. */
const path = Astro.url.pathname;
const items = [
  { href: '/work/', label: 'Work' },
  { href: '/research/', label: 'Research' },
  { href: '/about/', label: 'About' },
];
---

<header class="top">
  <nav class="frame grid" aria-label="Primary">
    <a class="name" href="/">Qilmeg Doudatcz</a>
    {
      items.map(({ href, label }, i) => (
        <a
          class="link"
          style={`grid-column: ${7 + i * 2} / span 2`}
          href={href}
          aria-current={path.startsWith(href) ? 'page' : undefined}
        >
          {label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .top {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    pointer-events: none;
  }

  .top a {
    pointer-events: auto;
  }

  .top nav {
    align-items: baseline;
  }

  .name {
    grid-column: 1 / span 3;
    justify-self: start;
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.5;
    text-decoration: none;
  }

  .link {
    justify-self: start;
    font-size: 1.4rem;
    font-weight: 300;
  }

  @media (max-width: 760px) {
    .top {
      background: var(--bg);
    }

    .top nav {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem 2rem;
    }

    .name {
      flex-basis: 100%;
    }
  }
</style>
