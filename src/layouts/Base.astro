---
import '../styles/theme.css';
// The only Vercel-specific code in the site. Off Vercel it just 404s a script;
// to self-host, delete this import and the <Analytics /> tag below.
import Analytics from '@vercel/analytics/astro';
import Nav from '../components/Nav.astro';

interface Props {
  title: string;
  description?: string;
  /** Landing map: the name sits in the middle of the map, so the header leaves it out. */
  home?: boolean;
  /** Extra class on <body>, for page-level rules (scroll snap, no scroll). */
  bodyClass?: string;
}

const {
  title,
  description = 'Qilmeg Doudatcz — designer, developer and researcher working on 3D neural scene representations, XR and computational design.',
  home = false,
  bodyClass,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <Analytics />
  </head>

  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <!-- One shared filter: ink bleeding a pixel into the paper. -->
    <svg width="0" height="0" style="position: absolute" aria-hidden="true">
      <filter id="bleed" x="-5%" y="-5%" width="110%" height="110%">
        <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="4" result="n"></feTurbulence>
        <feDisplacementMap in="SourceGraphic" in2="n" scale="1.5" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
      </filter>
    </svg>
    <Nav home={home} />
    <main id="main">
      <slot />
    </main>
    <script>
      import { drawShared, onLayout } from '../scripts/ink';
      onLayout(drawShared);
    </script>
  </body>
</html>
