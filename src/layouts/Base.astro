---
import '../styles/theme.css';
// The only Vercel-specific code in the site. Off Vercel it just 404s a script;
// to self-host, delete this import and the <Analytics /> tag below.
import Analytics from '@vercel/analytics/astro';
import Nav from '../components/Nav.astro';
import SideMenu from '../components/SideMenu.astro';

interface Props {
  title: string;
  description?: string;
  /** Show the pinned project menu on the left (work and project pages). */
  sideMenu?: boolean;
}

const {
  title,
  description = 'Qilmeg Doudatcz — architecture, computation, XR, heritage.',
  sideMenu = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <Analytics />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    {sideMenu && <SideMenu />}
    <main id="main">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  /* On phones the side menu is in the flow above the content, and has already
     cleared the header — the content below doesn't need to again. */
  @media (max-width: 760px) {
    .side + main .main {
      padding-top: 2rem;
    }
  }
</style>
