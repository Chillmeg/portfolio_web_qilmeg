---
import Base from '../layouts/Base.astro';

/* Cargo's landing page: a looping YouTube video as the page backdrop, inset by
   an 8rem margin and cover-cropped to fill it. Muted autoplay needs mute=1 as
   well as autoplay=1, and YouTube only loops with an explicit playlist. */
const id = 'n9dc7y0t1SQ';
const params = new URLSearchParams({
  autoplay: '1',
  mute: '1',
  loop: '1',
  playlist: id,
  controls: '0',
  rel: '0',
  playsinline: '1',
  modestbranding: '1',
});
const src = `https://www.youtube-nocookie.com/embed/${id}?${params}`;
---

<Base title="Qilmeg Doudatcz">
  <div class="backdrop" aria-hidden="true">
    <iframe
      src={src}
      title="Portfolio reel"
      tabindex="-1"
      allow="autoplay; encrypted-media; picture-in-picture"
      referrerpolicy="strict-origin-when-cross-origin"></iframe>
  </div>
</Base>

<style>
  .backdrop {
    position: fixed;
    inset: 8rem;
    overflow: hidden;
    background: #000;
    container-type: size;
  }

  /* object-fit: cover, for an iframe: whichever of width/height overflows. */
  iframe {
    position: absolute;
    top: 50%;
    left: 50%;
    width: max(100cqw, 100cqh * 16 / 9);
    height: max(100cqh, 100cqw * 9 / 16);
    transform: translate(-50%, -50%);
    border: 0;
    pointer-events: none;
  }

  @media (max-width: 760px) {
    .backdrop {
      inset: 8rem var(--pad) var(--pad);
    }
  }
</style>
