---
import Base from '../layouts/Base.astro';

// Transcribed from assets_web/01_Reference/research.md. Keep that file the
// source of truth and re-sync by hand — it's a page's worth of citations, not
// enough to justify a markdown pipeline.
const publications = [
  {
    text: 'Doudatcz, Q., & Nagakura, N. (2026). Designing AI to design experiment for studying humans in spatial design: framework and case study.',
    venue: 'Paper accepted, ACADIA 2026.',
  },
  {
    text: 'Doudatcz, Q., & Nagakura, N. (2026). Morphic Memory: A crowdsourced vision-language framework for documenting vernacular architectural intelligence.',
    venue: 'Abstract accepted, SiGraDi 2026.',
  },
  {
    text: 'Ataman, B., Gallardo, R., Doudatcz, Q. (2026). Affective translation: Emotional engagement with textile soft robots across physical and augmented embodiments.',
    venue: 'HCI International 2026 Posters (pp. 3–12). Springer.',
    href: 'https://doi.org/10.1007/978-3-032-30819-1_1',
  },
  {
    text: 'Gallardo, R., Doudatcz, Q., Goldstein, G., Sarimehmetoglu, I., Mutis, S., Kyaw, A. H., Lin, A., Emmerling, C., Ataman, B., & Tibbits, S. (2026). Context aware AI assistant and AR interface for lunar extravehicular activity (EVA) procedural guidance.',
    venue: "SIGGRAPH '26 Conference Posters. ACM.",
    href: 'https://doi.org/10.1145/3799825.3818743',
  },
  {
    text: 'Ataman, B., Gallardo, R., & Doudatcz, Q. (2025). Affective translation: Material and virtual embodiments of kinetic textile robots.',
    venue: 'arXiv:2601.11543 [cs.HC].',
    href: 'https://doi.org/10.48550/arXiv.2601.11543',
  },
  {
    text: 'Doudatcz, Q. (2025). Yertönts, the vertical world.',
    venue: 'Dimensions, 38(1), 80.',
  },
  {
    text: 'Tuladhar, S.*, Doudatcz, Q.*, & Samuelson, H. (in preparation). Measured thermal comfort performance of custom rice-husk insulation in cold climate emergency shelters.',
    venue: 'Target journal: Building and Environment.',
  },
];

const blogs = [
  {
    text: 'Erus, D., Liu, Y., & Doudatcz, Q. (2025). Multimodal scene representation learning for spatial and temporal understanding in video. MIT 6.7960 Final Project.',
    href: 'https://chillmeg.github.io/25FA_MIT_67960_DL/',
  },
  {
    text: 'RealityCapture Workflow Notes: Photogrammetry for Spatial Reconstruction',
    href: 'https://upbeat-temper-37d.notion.site/264575007a8c80d2bc58c9b72de221bd?v=264575007a8c801b8f9e000c4986d3fc&source=copy_link',
  },
];
---

<Base
  title="Research — Qilmeg Doudatcz"
  description="Publications and writing by Qilmeg Doudatcz."
>
  <div class="frame grid main">
    <div class="col-text">
      <h2>Publications</h2>
      <ul>
        {
          publications.map((p) => (
            <li>
              {p.text} {p.venue}
              {p.href && (
                <>
                  {' '}
                  <a href={p.href} target="_blank" rel="noopener">
                    {p.href}
                  </a>
                </>
              )}
            </li>
          ))
        }
      </ul>

      <h2 class="later">Blogs</h2>
      <ul>
        {
          blogs.map((b) => (
            <li>
              <a href={b.href} target="_blank" rel="noopener">
                {b.text}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Base>

<style>
  ul {
    margin-top: 1.5em;
  }

  li {
    margin-bottom: 1.5em;
    overflow-wrap: anywhere;
  }

  .later {
    margin-top: 1.5em;
  }
</style>
