---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Video from '../../components/Video.astro';
import Embed from '../../components/Embed.astro';
import YouTube from '../../components/YouTube.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

// Eagerly globbed so galleries resolve at build time. Raster and SVG are split:
// astro:assets optimises the former, and SVGs are already resolution
// independent so they pass through untouched.
const raster = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/projects/*/*.{jpeg,jpg,png,webp,avif}',
  { eager: true },
);
const vector = import.meta.glob<string>('../../assets/projects/*/*.svg', {
  eager: true,
  query: '?url',
  import: 'default',
});

const inThisProject = (p: string) => p.includes(`/projects/${project.slug}/`);
const fileName = (p: string) => p.slice(p.lastIndexOf('/') + 1);

type Asset = { raster: ImageMetadata } | { vector: string };
const assets = new Map<string, Asset>();
for (const k of Object.keys(raster).filter(inThisProject)) {
  assets.set(fileName(k), { raster: raster[k].default });
}
for (const k of Object.keys(vector).filter(inThisProject)) {
  assets.set(fileName(k), { vector: vector[k] });
}

// Listed images first, in the order given; anything else in the folder after,
// alphabetically. A listed file that doesn't exist fails the build rather than
// silently vanishing from the page.
const listed = (project.images ?? []).map((s) => (typeof s === 'string' ? { file: s } : s));
for (const { file } of listed) {
  if (!assets.has(file)) {
    throw new Error(`${project.slug}: images lists "${file}", not found in src/assets/projects/${project.slug}/`);
  }
}
const unlisted = [...assets.keys()]
  .filter((f) => !listed.some((s) => s.file === f))
  .sort()
  .map((file) => ({ file, caption: undefined }));

const shots = [...listed, ...unlisted].map((s) => ({ ...s, asset: assets.get(s.file)! }));

const description = project.body?.[0]?.slice(0, 160);

// Neighbours in work-page order, for the links at the foot of the page.
const at = projects.indexOf(project);
const prev = projects[at - 1];
const next = projects[at + 1];
const fmt = (v: number) => (v >= 0 ? '+' : '−') + Math.abs(v).toFixed(2);
---

<Base title={`${project.title} — Qilmeg Doudatcz`} description={description}>
  <article class="page">
    <div class="crumbs mono">
      <a href="/work/">← work</a>
      <a href="/" title="Where this sits on the map">x {fmt(project.map.x)} · y {fmt(project.map.y)}</a>
    </div>

    <header class="head">
      <span class="mono type">{project.type}</span>
      <h1>{project.title}</h1>
      {
        project.meta && (
          <p class="meta note">
            {project.meta.map((m, i) => (
              <>
                {i > 0 && <br />}
                {m.href ? (
                  <a href={m.href} target="_blank" rel="noopener">
                    {m.text}
                  </a>
                ) : (
                  m.text
                )}
              </>
            ))}
          </p>
        )
      }
    </header>

    {project.body && <div class="body">{project.body.map((para) => <p>{para}</p>)}</div>}

    {
      project.links && (
        <p class="links mono">
          {project.links.map((l) => (
            <a href={l.href} target="_blank" rel="noopener">
              {l.label} →
            </a>
          ))}
        </p>
      )
    }

    <div class="stack">
      {
        project.media?.map((m) =>
          m.kind === 'youtube' ? (
            <YouTube id={m.id} title={m.title} start={m.start} autoplay={m.autoplay} caption={m.caption} />
          ) : m.kind === 'video' ? (
            <Video src={m.src} poster={m.poster} caption={m.caption} aspect={m.aspect} />
          ) : (
            <Embed src={m.src} title={m.title} aspect={m.aspect} allow={m.allow} caption={m.caption} />
          ),
        )
      }

      {
        shots.map(({ asset, caption }, i) => (
          <figure class="shot">
            <div class:list={['img', { vec: 'vector' in asset }]} data-marks>
              {'vector' in asset ? (
                <img src={asset.vector} alt={caption ?? `${project.title} diagram`} loading="lazy" />
              ) : (
                <Image
                  src={asset.raster}
                  alt={caption ?? project.title}
                  widths={[480, 900, 1400]}
                  sizes="(max-width: 760px) 100vw, 760px"
                  loading="lazy"
                />
              )}
            </div>
            <figcaption>
              <span class="mono">fig. {String(i + 1).padStart(2, '0')}</span>
              {caption && <span class="note">{caption}</span>}
            </figcaption>
          </figure>
        ))
      }
    </div>

    <nav class="neighbours mono" aria-label="More work">
      {prev ? <a href={`/work/${prev.slug}/`}>← {prev.short}</a> : <span />}
      {next ? <a href={`/work/${next.slug}/`}>{next.short} →</a> : <span />}
    </nav>
  </article>
</Base>

<style>
  .page {
    max-width: 820px;
    margin: 0 auto;
    padding: calc(var(--header-h) + 32px) var(--gut-r) 120px var(--gut);
  }

  .crumbs {
    display: flex;
    justify-content: space-between;
    color: var(--ink-soft);
  }

  .crumbs a,
  .neighbours a,
  .links a {
    text-decoration: none;
  }

  .crumbs a:hover,
  .neighbours a:hover,
  .links a:hover {
    text-decoration: underline;
  }

  .head {
    display: grid;
    gap: 10px;
    margin: 56px 0 36px;
  }

  .type {
    color: var(--ink-soft);
  }

  h1 {
    margin: 0;
    font-weight: 500;
    font-size: clamp(24px, 2.6vw, 36px);
    line-height: 1.25;
    text-wrap: balance;
  }

  .meta {
    margin: 6px 0 0;
    font-size: 16px;
    line-height: 1.55;
  }

  .body {
    max-width: 62ch;
  }

  .body p {
    margin: 0 0 1.2em;
    font-size: 15px;
    line-height: 1.8;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 26px;
    margin: 8px 0 0;
  }

  .stack {
    display: grid;
    gap: 64px;
    margin-top: 56px;
  }

  /* Images keep their own proportions; tall ones are held to the screen. */
  .shot {
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 22px;
  }

  .img {
    width: fit-content;
    max-width: 100%;
  }

  .img :global(img) {
    display: block;
    max-width: 100%;
    max-height: 78vh;
    width: auto;
    height: auto;
  }

  /* SVGs have no size of their own, so they take the column width */
  .img.vec {
    width: 100%;
  }

  .img.vec :global(img) {
    width: 100%;
  }

  .shot figcaption {
    display: flex;
    gap: 14px;
    align-items: baseline;
    color: var(--ink-soft);
  }

  .shot figcaption .note {
    font-size: 15px;
  }

  .neighbours {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-top: 96px;
  }
</style>
