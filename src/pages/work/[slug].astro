---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Video from '../../components/Video.astro';
import Embed from '../../components/Embed.astro';
import YouTube from '../../components/YouTube.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

// Eagerly globbed so galleries resolve at build time. Raster and SVG are split:
// astro:assets optimises the former, and SVGs are already resolution
// independent so they pass through untouched.
const raster = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/projects/*/*.{jpeg,jpg,png,webp,avif}',
  { eager: true },
);
const vector = import.meta.glob<string>('../../assets/projects/*/*.svg', {
  eager: true,
  query: '?url',
  import: 'default',
});

const inThisProject = (p: string) => p.includes(`/projects/${project.slug}/`);
const fileName = (p: string) => p.slice(p.lastIndexOf('/') + 1);

type Asset = { raster: ImageMetadata } | { vector: string };
const assets = new Map<string, Asset>();
for (const k of Object.keys(raster).filter(inThisProject)) {
  assets.set(fileName(k), { raster: raster[k].default });
}
for (const k of Object.keys(vector).filter(inThisProject)) {
  assets.set(fileName(k), { vector: vector[k] });
}

// Listed images first, in the order given; anything else in the folder after,
// alphabetically. A listed file that doesn't exist fails the build rather than
// silently vanishing from the page.
const listed = (project.images ?? []).map((s) => (typeof s === 'string' ? { file: s } : s));
for (const { file } of listed) {
  if (!assets.has(file)) {
    throw new Error(`${project.slug}: images lists "${file}", not found in src/assets/projects/${project.slug}/`);
  }
}
const unlisted = [...assets.keys()]
  .filter((f) => !listed.some((s) => s.file === f))
  .sort()
  .map((file) => ({ file, caption: undefined }));

const shots = [...listed, ...unlisted].map((s) => ({ ...s, asset: assets.get(s.file)! }));

const description = project.body?.[0]?.slice(0, 160);
---

<Base title={`${project.title} — Qilmeg Doudatcz`} description={description} sideMenu>
  <article class="frame grid main">
    <div class="col-content">
      <h1>{project.title}</h1>

      {
        project.meta && (
          <p class="meta">
            {project.meta.map((m) => (
              <>
                {m.href ? (
                  <a href={m.href} target="_blank" rel="noopener">
                    {m.text}
                  </a>
                ) : (
                  m.text
                )}
                <br />
              </>
            ))}
          </p>
        )
      }

      {project.body?.map((para) => <p>{para}</p>)}

      {
        project.links && (
          <p>
            {project.links.map((l) => (
              <>
                <a href={l.href} target="_blank" rel="noopener">
                  {l.label}
                </a>
                <br />
              </>
            ))}
          </p>
        )
      }

      <div class="stack">
        {
          project.media?.map((m) =>
            m.kind === 'youtube' ? (
              <YouTube
                id={m.id}
                title={m.title}
                start={m.start}
                autoplay={m.autoplay}
                caption={m.caption}
              />
            ) : m.kind === 'video' ? (
              <Video src={m.src} poster={m.poster} caption={m.caption} aspect={m.aspect} />
            ) : (
              <Embed src={m.src} title={m.title} aspect={m.aspect} allow={m.allow} caption={m.caption} />
            ),
          )
        }

        {
          shots.map(({ asset, caption }) => (
            <figure>
              {'vector' in asset ? (
                <img src={asset.vector} alt={caption ?? `${project.title} diagram`} loading="lazy" />
              ) : (
                <Image
                  src={asset.raster}
                  alt={caption ?? project.title}
                  widths={[480, 900, 1400, 2000]}
                  sizes="(max-width: 760px) 100vw, 55vw"
                  loading="lazy"
                />
              )}
              {caption && <figcaption class="caption">{caption}</figcaption>}
            </figure>
          ))
        }
      </div>
    </div>
  </article>
</Base>

<style>
  /* Cargo wrapped these in a plain <small>, a notch under body size. */
  .meta {
    margin: 0 0 1.5em;
    font-size: 0.9em;
    line-height: 1.4;
  }

  p {
    margin: 0 0 1.5em;
  }

  .stack {
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  figure {
    margin: 0;
  }

  figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
