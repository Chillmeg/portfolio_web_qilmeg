---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import headshot from '../assets/about/headshot.jpg';
import { statement, bio, links, education, skills, roadmap, type CvSection } from '../data/cv';
import { entries } from '../data/research';

/* The CV as a page: a small figure and statement up top, then each section
   as a hand-ruled timeline — dates left, a pencil spine, entries right. */
const paperCount = entries.filter((e) => e.kind === 'p').length;
const external = (href: string) => href.startsWith('http');
---

<Base title="About — Qilmeg Doudatcz" description="Qilmeg Doudatcz — designer, developer and researcher. Education, skills, research and industry experience.">
  <div class="page">
    <section class="head">
      <figure class="portrait" data-marks>
        <Image src={headshot} alt="Qilmeg Doudatcz" widths={[240, 480]} sizes="190px" />
        <figcaption class="mono"><span>fig. 00</span><span>Cambridge, MA</span></figcaption>
      </figure>
      <div>
        <h1>Qilmeg Doudatcz</h1>
        <p class="statement">{statement}</p>
        <p class="bio">{bio}</p>
        <div class="links mono">
          {
            links.map((l) => (
              <a href={l.href} class:list={{ ring: l.ring }} {...(external(l.href) ? { target: '_blank', rel: 'noopener' } : {})}>
                {l.label}
                {l.ring && <svg class="ink bleed" data-ring="3" aria-hidden="true" />}
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {
      [education, 'skills', ...roadmap].map((s) =>
        s === 'skills' ? (
          <section class="sec">
            <h2 class="sec-h mono">
              Skills
              <svg class="ink bleed" data-underline aria-hidden="true" />
            </h2>
            <dl class="skills">
              {skills.map(([k, v]) => (
                <>
                  <dt class="mono">{k}</dt>
                  <dd>
                    {v.map((x) => (
                      <span>{x}</span>
                    ))}
                  </dd>
                </>
              ))}
            </dl>
          </section>
        ) : (
          <section class:list={['sec', { compact: (s as CvSection).compact }]}>
            <h2 class="sec-h mono">
              {(s as CvSection).heading}
              <svg class="ink bleed" data-underline aria-hidden="true" />
            </h2>
            <div class="tl">
              <svg class="ink bleed spine" aria-hidden="true" />
              {(s as CvSection).items.map((e) => (
                <div class="e">
                  <span class="when mono">{e.when}</span>
                  <span class="dot" />
                  <div class="what">
                    <h3>
                      {e.title.map((t, i) => (
                        <>
                          {i > 0 && <br />}
                          {t}
                        </>
                      ))}
                    </h3>
                    {e.where && <span class="where note">{e.where}</span>}
                  </div>
                </div>
              ))}
            </div>
          </section>
        ),
      )
    }

    <section class="sec">
      <h2 class="sec-h mono">
        Publications
        <svg class="ink bleed" data-underline aria-hidden="true"></svg>
      </h2>
      <div class="pubs">
        <p class="note">{paperCount} papers and preprints, 2025–2026. <a href="/research/">Read them on the research page →</a></p>
      </div>
    </section>
  </div>
</Base>

<style>
  .page {
    max-width: 940px;
    margin: 0 auto;
    padding: calc(var(--header-h) + 24px) var(--gut-r) 120px var(--gut);
  }

  .head {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 64px;
    align-items: start;
    margin: 36px 0 84px;
  }

  .portrait {
    width: 190px;
    margin: 14px 0 0 14px;
  }

  .portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
    filter: saturate(0.85);
  }

  .portrait figcaption {
    display: flex;
    justify-content: space-between;
    margin-top: 22px;
    color: var(--ink-soft);
  }

  h1 {
    margin: 0 0 18px;
    font-weight: 500;
    font-size: clamp(26px, 3vw, 40px);
    letter-spacing: 0.01em;
  }

  .statement {
    max-width: 36em;
    margin: 0 0 22px;
    font-size: 17px;
    line-height: 1.6;
  }

  .bio {
    max-width: 44em;
    margin: 0 0 28px;
    font-size: 14px;
    line-height: 1.75;
    color: var(--ink-soft);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 26px;
  }

  .links a {
    position: relative;
    padding: 4px 0;
    text-decoration: none;
  }

  .links a:hover {
    text-decoration: underline;
  }

  .links a.ring {
    padding: 4px 10px;
  }

  .sec {
    margin-top: 72px;
  }

  .tl {
    position: relative;
  }

  .tl .spine {
    left: 150px;
    width: 2px;
  }

  .e {
    position: relative;
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    column-gap: 40px;
    padding: 0 0 20px;
  }

  .when {
    padding: 4px 22px 0 0;
    text-align: right;
    color: var(--ink-soft);
  }

  .dot {
    position: absolute;
    left: 150px;
    top: 9px;
    width: 9px;
    height: 9px;
    margin-left: -4.5px;
    border-radius: 50%;
    border: 1px solid var(--ink);
    background: var(--paper);
  }

  .e:hover .dot {
    background: var(--ink);
  }

  .what {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  h3 {
    margin: 0;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.5;
  }

  .where {
    font-size: 16px;
  }

  .compact .e {
    padding-bottom: 14px;
  }

  .compact h3 {
    font-size: 14px;
  }

  .skills {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    column-gap: 40px;
    row-gap: 18px;
    margin: 0;
  }

  .skills dt {
    padding: 3px 22px 0 0;
    text-align: right;
    color: var(--ink-soft);
  }

  .skills dd {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 0;
    font-size: 14px;
  }

  .pubs {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    column-gap: 40px;
  }

  .pubs p {
    grid-column: 2;
    margin: 0;
    font-size: 16px;
  }

  @media (max-width: 760px) {
    .head {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
      margin-top: 20px;
    }

    .portrait {
      width: 150px;
    }

    .tl .spine {
      left: 6px;
    }

    .e {
      grid-template-columns: minmax(0, 1fr);
      padding-left: 28px;
    }

    .when {
      padding: 0 0 4px;
      text-align: left;
    }

    .dot {
      left: 6px;
      top: 4px;
    }

    .skills,
    .pubs {
      grid-template-columns: minmax(0, 1fr);
    }

    .skills dt {
      padding: 0;
      text-align: left;
    }

    .pubs p {
      grid-column: 1;
    }
  }
</style>

<script>
  import { rule, onLayout } from '../scripts/ink';

  // a pencil spine through each timeline, from its first dot to its last
  onLayout(() => {
    document.querySelectorAll<HTMLElement>('.tl').forEach((tl, k) => {
      const spine = tl.querySelector<SVGSVGElement>('.spine')!;
      const dots = [...tl.querySelectorAll<HTMLElement>('.dot')];
      const y = (d: HTMLElement) => d.parentElement!.offsetTop + d.offsetTop + 4.5;
      spine.innerHTML = '';
      if (dots.length > 1) rule(spine, 0, y(dots[0]), 0, y(dots[dots.length - 1]), 600 + k, 0.9, 0.6);
    });
  });
</script>
